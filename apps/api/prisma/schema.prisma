generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("EDITOR") // ADMIN | EDITOR
  createdAt DateTime @default(now())

  posts Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  category  String   @default("NOTICE") // NOTICE | NEWS | PRESS
  title     String
  content   String
  published Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  @@index([category, createdAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  status    String   @default("NEW") // NEW | IN_PROGRESS | DONE
  memo      String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// 제품 카테고리 — parentId 로 최대 3차(대/중/소)까지 계층을 구성한다.
model Category {
  id        Int    @id @default(autoincrement())
  name      String
  slug      String @unique
  /// 1=대분류, 2=중분류, 3=소분류. 저장 시 부모 depth+1 로 검증한다.
  depth     Int    @default(1)
  sortOrder Int    @default(0)

  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())

  @@index([parentId, sortOrder])
}

model Product {
  id        Int     @id @default(autoincrement())
  name      String
  model     String?
  /// 목록 카드에 노출되는 한 줄 요약
  summary   String?
  price     Int?
  /// 썸네일 — 업로드 경로(/uploads/..) 또는 외부 URL
  thumbnail String?
  /// 상세 본문 (TipTap 이 생성한 HTML)
  content   String  @default("")
  /// 사양 테이블 [{label, value}] 을 JSON 문자열로 저장한다 (SQLite 는 배열 타입이 없음)
  specs     String  @default("[]")
  published Boolean @default(true)
  featured  Boolean @default(false)
  views     Int     @default(0)
  sortOrder Int     @default(0)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, createdAt])
  @@index([published, featured])
}

/// 관리자가 직접 만드는 일반 페이지 (회사소개, 이용약관 등)
model Page {
  id          Int     @id @default(autoincrement())
  /// 사이트 주소에 쓰이는 식별자 — /page/:slug
  slug        String  @unique
  title       String
  /// 상단 히어로에 노출되는 한 줄 설명
  description String?
  /// 본문 (TipTap 이 생성한 HTML)
  content     String  @default("")
  /// 발행 여부 — 끄면 홈페이지에서 보이지 않는다.
  published   Boolean @default(false)
  /// 처음 발행한 시각. 미발행 상태면 null.
  publishedAt DateTime?
  /// 상단 메뉴에 링크를 걸지 여부
  showInNav   Boolean @default(false)
  sortOrder   Int     @default(0)
  views       Int     @default(0)
  /// 현재 내용의 버전 번호 — versions 의 최신 version 과 같다.
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PageVersion[]

  @@index([published, sortOrder])
}

/// 페이지를 저장할 때마다 남기는 스냅샷. 이전 버전으로 되돌릴 때 사용한다.
model PageVersion {
  id      Int  @id @default(autoincrement())
  pageId  Int
  page    Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// 페이지 안에서 1부터 증가하는 번호
  version Int

  title       String
  description String?
  content     String
  published   Boolean
  showInNav   Boolean

  /// 이 버전이 만들어진 이유 — 최초 작성 / 수정 / n번 버전 복원
  note       String?
  authorId   Int?
  authorName String
  createdAt  DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, version])
}

/// 사이트 전역 설정 — 항상 한 행(id=1)만 사용한다.
model SiteSetting {
  id          Int     @id @default(autoincrement())
  siteName    String  @default("")
  siteUrl     String  @default("")
  /// 사이트에 대한 간단한 설명
  description String?
  adminEmail  String  @default("")
  /// 헤더에 표시될 로고 이미지 — 업로드 경로(/uploads/..) 또는 외부 URL
  titleImage  String?

  // --- SEO ---
  /// 검색 결과에 노출될 제목. 비우면 사이트 이름을 쓴다.
  metaTitle       String?
  /// 검색 결과 요약문 (160자 내외 권장)
  metaDescription String?
  /// 쉼표로 구분한 키워드
  metaKeywords    String?
  /// SNS 공유 카드에 쓰이는 제목·설명·이미지. 비우면 메타 값을 따른다.
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  /// 검색엔진 수집 허용 여부 (끄면 noindex)
  allowIndexing      Boolean @default(true)
  /// 구글 서치 콘솔 / 네이버 서치어드바이저 소유확인 코드
  googleVerification String?
  naverVerification  String?
  /// Google Analytics 측정 ID (G-XXXXXXX)
  gaId               String?

  updatedAt DateTime @updatedAt
}
