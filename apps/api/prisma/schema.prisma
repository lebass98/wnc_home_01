generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("EDITOR") // ADMIN | EDITOR
  createdAt DateTime @default(now())

  posts Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  category  String   @default("NOTICE") // NOTICE | NEWS | PRESS
  title     String
  content   String
  published Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  @@index([category, createdAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  status    String   @default("NEW") // NEW | IN_PROGRESS | DONE
  memo      String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// 제품 카테고리 — parentId 로 최대 3차(대/중/소)까지 계층을 구성한다.
model Category {
  id        Int    @id @default(autoincrement())
  name      String
  slug      String @unique
  /// 1=대분류, 2=중분류, 3=소분류. 저장 시 부모 depth+1 로 검증한다.
  depth     Int    @default(1)
  sortOrder Int    @default(0)

  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())

  @@index([parentId, sortOrder])
}

model Product {
  id        Int     @id @default(autoincrement())
  name      String
  model     String?
  /// 목록 카드에 노출되는 한 줄 요약
  summary   String?
  price     Int?
  /// 썸네일 — 업로드 경로(/uploads/..) 또는 외부 URL
  thumbnail String?
  /// 상세 본문 (TipTap 이 생성한 HTML)
  content   String  @default("")
  /// 사양 테이블 [{label, value}] 을 JSON 문자열로 저장한다 (SQLite 는 배열 타입이 없음)
  specs     String  @default("[]")
  published Boolean @default(true)
  featured  Boolean @default(false)
  views     Int     @default(0)
  sortOrder Int     @default(0)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, createdAt])
  @@index([published, featured])
}

/// 관리자가 직접 만드는 일반 페이지 (회사소개, 이용약관 등)
model Page {
  id          Int     @id @default(autoincrement())
  /// 사이트 주소에 쓰이는 식별자 — /page/:slug
  slug        String  @unique
  title       String
  /// 상단 히어로에 노출되는 한 줄 설명
  description String?
  /// 본문 (TipTap 이 생성한 HTML)
  content     String  @default("")
  /// 발행 여부 — 끄면 홈페이지에서 보이지 않는다.
  published   Boolean @default(false)
  /// 처음 발행한 시각. 미발행 상태면 null.
  publishedAt DateTime?
  /// 상단 메뉴에 링크를 걸지 여부
  showInNav   Boolean @default(false)
  sortOrder   Int     @default(0)
  views       Int     @default(0)
  /// 현재 내용의 버전 번호 — versions 의 최신 version 과 같다.
  version     Int     @default(1)

  // --- 검색 노출(SEO) — 비우면 제목·한 줄 설명·사이트 기본값을 쓴다 ---
  metaTitle       String?
  metaDescription String?
  /// SNS 공유 이미지 — 업로드 경로(/uploads/..) 또는 외부 URL
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PageVersion[]

  @@index([published, sortOrder])
}

/// 페이지를 저장할 때마다 남기는 스냅샷. 이전 버전으로 되돌릴 때 사용한다.
model PageVersion {
  id      Int  @id @default(autoincrement())
  pageId  Int
  page    Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// 페이지 안에서 1부터 증가하는 번호
  version Int

  title       String
  description String?
  content     String
  published   Boolean
  showInNav   Boolean

  /// 이 버전이 만들어진 이유 — 최초 작성 / 수정 / n번 버전 복원
  note       String?
  authorId   Int?
  authorName String
  createdAt  DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, version])
}

/// 사이트 전역 설정 — 항상 한 행(id=1)만 사용한다.
model SiteSetting {
  id          Int     @id @default(autoincrement())
  siteName    String  @default("")
  siteUrl     String  @default("")
  /// 사이트에 대한 간단한 설명
  description String?
  adminEmail  String  @default("")
  /// 헤더에 표시될 로고 이미지 — 업로드 경로(/uploads/..) 또는 외부 URL
  titleImage  String?

  // --- SEO ---
  /// 검색 결과에 노출될 제목. 비우면 사이트 이름을 쓴다.
  metaTitle       String?
  /// 모든 페이지 제목 뒤에 붙는 문구 (예: " | 워드앤코드")
  titleSuffix     String?
  /// 검색 결과 요약문 (160자 내외 권장)
  metaDescription String?
  /// 쉼표로 구분한 키워드
  metaKeywords    String?
  /// SNS 공유(Open Graph) 태그 출력 여부. 끄면 og:* 를 내보내지 않는다.
  ogEnabled     Boolean @default(true)
  /// SNS 공유 카드에 쓰이는 제목·설명·이미지. 비우면 메타 값을 따른다.
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  /// 공유 이미지 대체 텍스트
  ogImageAlt    String?
  /// og:site_name — 비우면 사이트 이름을 쓴다.
  ogSiteName    String?
  /// og:type (website | article)
  ogType        String  @default("website")
  /// og:locale (예: ko_KR)
  ogLocale      String  @default("ko_KR")
  /// 검색엔진 수집 허용 여부 (끄면 noindex)
  allowIndexing      Boolean @default(true)
  /// 구글 서치 콘솔 / 네이버 서치어드바이저 소유확인 코드
  googleVerification String?
  naverVerification  String?
  /// Google Analytics 측정 ID (G-XXXXXXX)
  gaId               String?
  /// generator 메타 태그 출력 여부와 내용. 내용을 비우면 기본값을 쓴다.
  generatorEnabled Boolean @default(true)
  generatorContent String?

  // --- 회사 정보: 푸터 · 문의하기 · 찾아오시는 길이 모두 여기 값을 읽는다 ---
  companyName String @default("워드앤코드")
  /// 푸터 로고와 저작권 문구에 쓰는 영문 이름
  companyNameEn String @default("WORDNCODE")
  ceo           String @default("")
  /// 사업자등록번호
  bizNo         String @default("")
  zipCode       String @default("08510")
  address       String @default("서울 금천구 벚꽃로 298(가산동 50-3) 대륭포스트타워6차 2층 227호")
  tel           String @default("02-2261-5555")
  fax           String @default("02-863-5554")
  email         String @default("help@wordncode.com")
  /// 업무시간 — 줄바꿈으로 여러 줄을 쓸 수 있다
  hours         String @default("평일 09:00 - 18:00\n점심 12:00 - 13:00 · 주말·공휴일 휴무")
  /// 설립연도 — 저작권 문구의 시작 연도
  since         String @default("2003")
  /// 저작권 문구 — 앞에 '설립연도-올해' 가 자동으로 붙는다
  copyright     String @default("ⓒ BY WORDNCODE. ALL RIGHTS RESERVED.")
  /// 찾아오시는 길 지도에 표시할 위치 — 구글 지도 검색어
  mapQuery      String @default("서울 금천구 벚꽃로 298")
  /// 찾아오시는 길 본사 아래 안내 문구
  directionsGuide String @default("1호선·7호선 가산디지털단지역 5번 출구에서 도보 7분 거리입니다. 건물 지하 주차장을 이용하실 수 있으며, 방문 전 연락 주시면 주차권을 준비해 드립니다.")
  /// SNS 주소 — 비우면 푸터 아이콘을 감춘다
  snsFacebook  String @default("")
  snsYoutube   String @default("")
  snsBlog      String @default("")
  snsInstagram String @default("https://www.instagram.com/wordncode__/")
  /// 지점 목록 [{name, phone, email, address}] — JSON 문자열
  branches     String @default("[]")

  updatedAt DateTime @updatedAt
}

/// 게시판 환경설정 — 항상 한 행만 사용한다.
model BoardSetting {
  id Int @id @default(autoincrement())

  // --- SEO: 페이지 유형별 메타 템플릿 ({site_name} 같은 변수를 쓸 수 있다) ---
  /// 게시판 목록 페이지 (/board)
  seoListTitle       String @default("{site_name}")
  seoListDescription String @default("")
  /// 분류를 고른 글 목록 페이지
  seoBoardTitle       String @default("{board_name}")
  seoBoardDescription String @default("{board_description}")
  /// 게시글 상세 페이지
  seoPostTitle       String @default("{board_name} - {post_title}")
  seoPostDescription String @default("")

  /// 검색 봇에게 메타 정보를 제공할 페이지
  seoServeList  Boolean @default(true)
  seoServeBoard Boolean @default(true)
  seoServePost  Boolean @default(true)

  /// 캐시를 마지막으로 비운 시각
  seoCacheResetAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

/// 게시판 — 글이 속하는 묶음. Post.category 가 이 slug 를 가리킨다.
model Board {
  id   Int    @id @default(autoincrement())
  /// 기본 언어(ko) 게시판명. 목록·검색에서 대표 이름으로 쓴다.
  name String
  /// 글의 category 값으로 쓰인다.
  slug String @unique
  /// 목록 표시 방식: basic(기본형) | gallery(갤러리형) | card(카드형)
  type String @default("basic")
  /// 기본 언어(ko) 설명
  description String?

  /// 언어별 게시판명 {"ko":"공지사항","en":"Notice"} — JSON 문자열
  nameI18n        String @default("{}")
  /// 언어별 설명
  descriptionI18n String @default("{}")

  /// 끄면 홈페이지 소식 화면에서 감춘다.
  published Boolean @default(true)
  sortOrder Int     @default(0)

  /// 관리자 사이드바 [게시판 관리] 아래에 바로가기를 노출한다.
  showInAdminMenu Boolean @default(false)

  /// 글 분류 목록 ["공지","안내"] — JSON 문자열
  categories String @default("[]")

  /// 비밀글 모드: off(사용 안 함) | optional(작성자 선택) | always(항상 비밀글)
  secretMode String @default("off")

  /// 목록·상세에 조회수를 표시한다.
  showViews Boolean @default(true)
  /// 부적절한 글·댓글 신고 기능을 쓴다.
  useReport Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// 홈페이지 방문자에게 띄우는 팝업 — 게시기간 안에서만 노출된다.
model Popup {
  id   Int    @id @default(autoincrement())
  /// 관리자 목록에서 구분하는 이름. 방문자에게는 보이지 않는다.
  name String

  /// 노출 위치: main(메인페이지만) | path(특정 페이지)
  placement String @default("main")
  /// placement 가 path 일 때 노출할 페이지 주소 (예: /products)
  placementPath String?

  /// 팝업창 형태: window(일반 윈도우) | fixed(고정 레이어) | draggable(이동 가능한 레이어)
  windowType String @default("fixed")
  /// 스크롤바: auto(자동) | none(없음) | always(있음)
  scrollbar String @default("none")

  /// 팝업 본문 (TipTap 이 생성한 HTML)
  content String @default("")
  /// 이미지형 팝업일 때 쓰는 이미지 — 업로드 경로(/uploads/..) 또는 외부 URL
  image String?
  /// 팝업(또는 이미지)을 눌렀을 때 이동할 주소. 비우면 링크를 걸지 않는다.
  linkUrl String?
  /// 링크를 새 창으로 열지 여부
  linkNewTab Boolean @default(false)

  /// 게시 시작·종료 일시. 이 구간 밖에서는 노출하지 않는다.
  startAt DateTime
  endAt   DateTime

  /// 관리자가 직접 끄고 켜는 스위치. 끄면 기간 안이어도 노출하지 않는다.
  enabled Boolean @default(true)

  /// 화면에서의 위치 — 상단/좌측 기준 픽셀
  positionTop  Int @default(120)
  positionLeft Int @default(120)
  /// 팝업창 크기
  width  Int @default(400)
  height Int @default(500)

  /// 표시기간(다시 보지 않기) 옵션:
  /// day(하루동안 열지 않음) | never(다시 열지 않음) | session(브라우저 닫을 때까지)
  hidePeriod String @default("day")

  /// 여러 개가 동시에 뜰 때의 순서. 작을수록 먼저 나온다.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, startAt, endAt])
}

model Faq {
  id Int @id @default(autoincrement())
  /// 분류 — 홈페이지 목록에서 질문 앞에 작게 보여 준다 (예: 서비스, 견적·계약). 비워 둘 수 있다.
  category String @default("")
  question String
  /// 답변 — 평문으로 저장하고 줄바꿈만 유지해 보여 준다.
  answer String
  /// 끄면 홈페이지 자주 묻는 질문에서 감춘다.
  published Boolean @default(true)
  /// 목록 순서. 작을수록 위에 온다.
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// 자주 묻는 질문의 분류 — 관리자가 등록해 두고 질문 작성 시 골라 쓴다. Faq.category 에는 이름이 들어간다.
model FaqCategory {
  id Int @id @default(autoincrement())
  name String @unique
  /// 홈페이지 탭 순서. 작을수록 앞에 온다.
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 개인정보처리방침 개정 이력 — 홈페이지 방침 하단의 '개정이력' 표에 보이고, 자세히보기로 당시 본문을 연다.
model PrivacyRevision {
  id Int @id @default(autoincrement())
  /// 표에 보이는 제목 (예: 개인정보처리방침 v1.2)
  title String
  /// 시행일
  effectiveAt DateTime
  /// 변경 요약 — 표 아래 한 줄로 보인다. 비워 둘 수 있다.
  summary String @default("")
  /// 당시 방침 본문 (평문, 줄바꿈 유지)
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([effectiveAt])
}

/// 홈페이지 메뉴 — GNB·푸터·사이트맵이 모두 이 표를 읽는다. parentId 로 1차/2차 두 단계까지만 쓴다.
model MenuItem {
  id Int @id @default(autoincrement())
  parentId Int?
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  label String
  /// 이동할 주소 — 사이트 안 경로(/about) 또는 외부 주소(https://…). 비우면 글자만 보인다.
  url String @default("")
  /// 새 창으로 열기
  newTab Boolean @default(false)
  /// 2차 메뉴를 서버 데이터로 자동으로 채운다: none | categories(제품 대분류) | boards(게시판)
  autoChildren String @default("none")

  /// 끄면 어디에도 보이지 않는다.
  published     Boolean @default(true)
  showInGnb     Boolean @default(true)
  showInFooter  Boolean @default(true)
  showInSitemap Boolean @default(true)

  /// 같은 부모 안에서의 순서. 작을수록 앞에 온다.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
}

/// 프론트 화면별 레이아웃 — 페이지 관리에서 경로 단위로 고른다.
model SitePageLayout {
  id   Int    @id @default(autoincrement())
  /// 화면 경로 (/about, /page/terms-of-use 등). 패턴 경로(:id 포함)는 쓰지 않는다.
  path String @unique
  /// basic(기본 서브) | left(좌측 메뉴 서브)
  layout String @default("basic")

  updatedAt DateTime @updatedAt
}
