{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npx prisma generate --schema apps/api/prisma/schema.prisma && npm run build:web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{apps/api/src/**,packages/shared/src/**,templates/*/template.json}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/((?!assets/|images/|fonts/|videos/|favicon).*)", "destination": "/index.html" }
  ]
}
